{
  "manifest_version": 3,
  "name": "Meta Assistant · Kết nối ChatGPT",
  "version": "2.5.3",
  "description": "Studio AI: chọn Page có avatar, tạo bài và ảnh bằng GPT nhúng, lưu nháp và chuyển sang web khi bạn chọn.",
  "permissions": [
    "storage",
    "sidePanel",
    "declarativeNetRequestWithHostAccess",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.oaiusercontent.com/*",
    "https://vanxharu.github.io/quan-ly-page/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vanxharu.github.io/quan-ly-page/*"
      ],
      "js": [
        "web-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "protocol.js",
        "chatgpt-agent.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Mở Studio AI · Meta Assistant",
    "default_icon": {
      "16": "icons/logo.png",
      "32": "icons/logo.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://chatgpt.com; img-src 'self' data: blob: https:; style-src 'self';"
  },
  "icons": {
    "16": "icons/logo.png",
    "32": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  }
}
